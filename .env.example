# Metadata storage
CONTEXT_GRAPH_METADATA_DSN=postgresql://context_graph:context_graph@localhost:5433/context_graph
POSTGRES_DSN=postgresql://context_graph:context_graph@localhost:5433/context_graph

# Graph backend
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=contextgraph
NEO4J_DATABASE=neo4j

# MCP namespace
NAMESPACE_GROUP_ID=main
NAMESPACE_USER_ID=mcp_user

# LLM / embeddings
OPENAI_API_KEY=
CONTEXT_GRAPH_LLM_PROVIDER=openai
CONTEXT_GRAPH_LLM_MODEL=gpt-4o-mini
CONTEXT_GRAPH_EMBED_PROVIDER=openai
CONTEXT_GRAPH_EMBED_MODEL=text-embedding-3-small
CONTEXT_GRAPH_EMBED_DIMENSIONS=1536
