{
  "mcpServers": {
    "context-graph": {
      "transport": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--package",
        "context-graph-mcp",
        "context-graph-mcp",
        "--transport",
        "stdio",
        "--config",
        "/ABSOLUTE/PATH/TO/Context-Graph/mcp_server/config/config.yaml"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "demodemo",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "NAMESPACE_GROUP_ID": "main"
      }
    }
  }
}
